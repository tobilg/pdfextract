{
  "name": "@pdfextract/documentation",
  "version": "0.1.0",
  "description": "Private TypeDoc documentation website for pdfextract.",
  "license": "MIT",
  "author": {
    "name": "tobilg",
    "url": "https://github.com/tobilg"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "typedoc",
    "check": "typedoc --emit none",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm build && node scripts/dev.mjs",
    "preview": "vite dist --host 127.0.0.1 --port 4174 --strictPort",
    "test": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@pdfextract/core": "workspace:*",
    "@pdfextract/ocr": "workspace:*",
    "@pdfextract/storage": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "wrangler": "4.147.0"
  }
}
