{
  "name": "@pdfextract/ocr",
  "version": "0.1.0",
  "description": "Lazy, self-hosted Tesseract OCR provider for @pdfextract/core in browsers and Node.js. No CDN or implicit model downloads.",
  "keywords": [
    "pdf",
    "ocr",
    "tesseract",
    "tesseract.js",
    "wasm",
    "text-recognition",
    "browser",
    "nodejs",
    "pdfextract"
  ],
  "license": "MIT",
  "author": {
    "name": "tobilg",
    "url": "https://github.com/tobilg"
  },
  "homepage": "https://pdfextract-api-docs.gh.tobilg.com/_pdfextract/ocr/",
  "bugs": {
    "url": "https://github.com/tobilg/pdfextract/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index-node.js",
      "default": "./dist/index.js"
    },
    "./assets/*": "./dist/assets/*"
  },
  "dependencies": {
    "fast-png": "6.4.0"
  },
  "peerDependencies": {
    "@pdfextract/core": "^0.1.0"
  },
  "devDependencies": {
    "@pdfextract/core": "workspace:*",
    "tesseract.js": "7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobilg/pdfextract.git",
    "directory": "packages/ocr"
  },
  "publishConfig": {
    "access": "public"
  }
}
