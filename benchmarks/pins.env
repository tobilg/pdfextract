# Pinned benchmark inputs and tools. download.sh and setup.sh read this file, and run.mjs
# records it with every result, so a score names exactly what produced it.

# opendataloader-bench: 200 PDFs with Markdown ground truth, and its evaluator.
ODL_BENCH_REPO=https://github.com/opendataloader-project/opendataloader-bench.git
ODL_BENCH_COMMIT=7af1d8f4d0c09f51ea1a5c6ba5f66e993286d109

# olmOCR-bench: 1,403 single-page PDFs with 7,010 unit tests (Hugging Face dataset).
OLMOCR_BENCH_DATASET=allenai/olmOCR-bench
OLMOCR_BENCH_REVISION=54a96a6fb6a2bd3b297e59869491db4d3625b711

# olmocr: the test classes that score olmOCR-bench.
OLMOCR_REPO=https://github.com/allenai/olmocr.git
OLMOCR_COMMIT=f7cfe4c22098b154c76b6ec950d1c0a464eecf8d

# Python for the scorers and the liteparse reference runner (requirements.txt pins packages).
PYTHON_VERSION=3.12
